# GEMINI_API_KEY: Required for server-side Gemini AI API calls via Vorta Model Gateway.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional External AI Providers (unconfigured providers run transparently in Demo mode)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""
OPENROUTER_API_KEY=""

# Optional PostgreSQL & Prisma Connection (for production Phase 2 deployment)
DATABASE_URL="postgresql://user:password@localhost:5432/vorta_ai?schema=public"

# Optional Iranian Payment Gateway (Zarinpal)
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="true"
